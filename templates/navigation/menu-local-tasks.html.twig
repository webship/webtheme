{#
/**
 * @file
 * Webtheme theme implementation to display primary and secondary local tasks.
 *
 * Delegates the markup to the webtheme:menu-local-tasks SDC.
 *
 * Available variables:
 * - primary: HTML list items representing primary tasks.
 * - secondary: HTML list items representing primary tasks.
 *
 * @ingroup themeable
 */
#}
{{ attach_library('webtheme/tabs') }}
{% embed 'webtheme:menu-local-tasks' %}
  {% block primary %}{{ primary }}{% endblock %}
  {% block secondary %}{{ secondary }}{% endblock %}
{% endembed %}
