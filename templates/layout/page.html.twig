{#
/**
 * @file
 * Theme override to display a single page.
 *
 * Built with the UIkit components of the theme: Navbar, Offcanvas and the
 * UIkit section, container and grid classes.
 *
 * Available variables (in addition to core ones):
 * - navbar_sticky: Whether the navbar sticks to the top (theme setting).
 * - offcanvas_id: The ID of the offcanvas printing the "Offcanvas" region.
 *
 * Regions:
 * - page.navbar_left, page.navbar_center, page.navbar_right: Navbar.
 * - page.offcanvas: Offcanvas, opened by the navbar toggle on small screens.
 * - page.header: Below the navbar (breadcrumb...).
 * - page.highlighted, page.help: Above the content.
 * - page.content: The main content of the current page.
 * - page.sidebar_first, page.sidebar_second: Sidebars.
 * - page.footer: Footer.
 *
 * @see template_preprocess_page()
 * @see \Drupal\webtheme\Hook\ThemeHooks::preprocessPage()
 */
#}
{% set navbar_toggle = page.offcanvas ? {
  '#type': 'component',
  '#component': 'webtheme:navbar_toggle',
  '#props': {
    'target': offcanvas_id,
    'attributes': {
      'class': ['uk-hidden@m'],
    },
  },
} %}

{% if page.navbar_left or page.navbar_center or page.navbar_right or page.offcanvas %}
  <header class="webtheme-header">
    {{ include('webtheme:navbar', {
      left: page.navbar_left,
      center: page.navbar_center,
      right: [page.navbar_right, navbar_toggle],
      sticky: navbar_sticky,
    }, with_context: false) }}
  </header>
{% endif %}

{% if page.offcanvas %}
  {{ include('webtheme:offcanvas', {
    content: page.offcanvas,
    offcanvas_id: offcanvas_id,
    mode: 'push',
    flip: true,
    overlay: true,
    close: true,
  }, with_context: false) }}
{% endif %}

{# Blocks like the breadcrumb can render nothing: skip the empty section. #}
{% set header = page.header|render %}
{% if header|striptags('<img><svg><form><input>')|trim %}
  <div class="uk-section uk-section-muted uk-section-xsmall">
    <div class="uk-container">
      {{ header }}
    </div>
  </div>
{% endif %}

<main role="main" class="uk-section uk-section-small">
  <div class="uk-container">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}
    {{ page.highlighted }}
    {{ page.help }}

    <div class="uk-grid uk-grid-large" uk-grid>
      {% if page.sidebar_first %}
        <aside class="uk-width-1-1 uk-width-1-4@m" role="complementary">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}

      <div class="uk-width-1-1 uk-width-expand@m">
        {{ page.content }}
      </div>

      {% if page.sidebar_second %}
        <aside class="uk-width-1-1 uk-width-1-4@m" role="complementary">
          {{ page.sidebar_second }}
        </aside>
      {% endif %}
    </div>
  </div>
</main>

{% if page.footer %}
  <footer role="contentinfo" class="uk-section uk-section-secondary uk-section-small">
    <div class="uk-container">
      {{ page.footer }}
      <div class="uk-text-right uk-margin-top">
        {{ include('webtheme:totop', {}, with_context: false) }}
      </div>
    </div>
  </footer>
{% endif %}
