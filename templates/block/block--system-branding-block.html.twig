{% extends "block.html.twig" %}
{#
/**
 * @file
 * Theme override for the site branding block, with the Logo component.
 *
 * Available variables:
 * - site_logo: Logo for site as defined in Appearance or theme settings.
 * - site_name: Name for site as defined in Site information settings.
 * - site_slogan: Slogan for site as defined in Site information settings.
 *
 * On small screens, the site name is only printed when there is no logo, so
 * the logo, the account menu and the offcanvas toggle fit in the navbar.
 */
#}
{% block content %}
  {{ include('webtheme:logo', {
    url: path('<front>'),
    image: site_logo,
    image_alt: site_name ? '' : 'Home'|t,
    image_height: 40,
    navbar_item: true,
    label: site_name and site_logo ? {
      '#type': 'html_tag',
      '#tag': 'span',
      '#attributes': {
        'class': ['uk-visible@m'],
      },
      '#value': site_name,
    } : site_name,
  }, with_context: false) }}
  {% if site_slogan %}
    <div class="uk-navbar-item uk-text-meta uk-visible@l">{{ site_slogan }}</div>
  {% endif %}
{% endblock %}
