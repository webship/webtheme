{#
/**
 * @file
 * Theme override for status messages.
 *
 * Delegates the markup to the webtheme:status-messages SDC. See that
 * component for the full variable documentation.
 *
 * Available variables:
 * - message_list: List of messages to be displayed, grouped by type.
 * - status_headings: List of all status types.
 * - attributes: HTML attributes for the element.
 */
#}
{{ attach_library('webtheme/messages') }}
{% include 'webtheme:status-messages' with {
  message_list: message_list,
  status_headings: status_headings,
} %}
