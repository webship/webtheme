{
  "name": "webtheme",
  "private": true,
  "description": "Tooling for the Webtheme Drupal theme.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">= 22.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "~12.9.0",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-yml": "^1.19.0",
    "globals": "^16.5.0",
    "stylelint": "^16.26.0",
    "stylelint-config-standard": "^39.0.0",
    "uikit": "3.25.22",
    "webship-js": "2.0.5"
  },
  "resolutions": {
    "@cucumber/cucumber": "~12.9.0"
  },
  "scripts": {
    "lint:js": "eslint tests/step-definitions cucumber.js eslint.config.js",
    "lint:yaml": "eslint \"*.yml\" \"config/**/*.yml\" \"components/**/*.yml\"",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:icons": "rm -f icons/uikit/*.svg && cp node_modules/uikit/src/images/icons/*.svg icons/uikit/",
    "test": "cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  }
}
