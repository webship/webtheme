{#
/**
 * @file
 * Webtheme SDC: site-branding.
 *
 * HTMX note: when the theme's HTMX boost is enabled, the home link is a
 * natural boost target — it swaps the page content in place. No extra
 * attributes needed; it inherits hx-boost from the <body>.
 */
#}
{% set branding_classes = ['site-branding'] %}
{% if bg is defined and bg and bg != 'default' %}
  {% set branding_classes = branding_classes|merge(['site-branding--bg-' ~ bg]) %}
{% endif %}
<div{{ attributes.addClass(branding_classes) }}>
  <div class="site-branding__inner">
    {% if site_logo %}
      <a href="{{ front_url ?: '/' }}" rel="home" class="site-branding__logo">
        <img src="{{ site_logo }}" alt="{{ 'Home'|t }}" />
      </a>
    {% endif %}
    {% if site_name %}
      <div class="site-branding__text">
        <div class="site-branding__name">
          <a href="{{ front_url ?: '/' }}" title="{{ 'Home'|t }}" rel="home">{{ site_name }}</a>
        </div>
      </div>
    {% endif %}
  </div>
</div>
