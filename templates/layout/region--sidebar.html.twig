{#
/**
 * @file
 * Webtheme's theme override to display the sidebar region.
 *
 * Delegates the markup to the webtheme:region SDC (aside wrapper).
 *
 * @see template_preprocess_region()
 */
#}
{{ attach_library('webtheme/sidebar') }}
{% if content %}
  {% embed 'webtheme:region' with { region: region, wrapper: 'aside' } %}
    {% block content %}{{ content }}{% endblock %}
  {% endembed %}
{% endif %}
