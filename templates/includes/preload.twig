{#
  Font preloading: the two weights every page uses, served from the theme
  (css/base/fonts.pcss.css declares the faces). webtheme_path already begins
  with a slash, so it is used without one here.
#}
<link rel="preload" href="{{ webtheme_path }}/fonts/zen-maru-gothic/zen-maru-gothic-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ webtheme_path }}/fonts/zen-maru-gothic/zen-maru-gothic-700-latin.woff2" as="font" type="font/woff2" crossorigin>
