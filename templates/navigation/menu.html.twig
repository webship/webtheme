{#
/**
 * @file
 * Theme override to display a menu, with the UIkit Nav component.
 *
 * Available variables:
 * - menu_name: The machine name of the menu.
 * - items: A nested list of menu items.
 * - attributes: HTML attributes for the menu.
 */
#}
{% if items %}
  {{ include('webtheme:nav', {
    items: items,
    accordion: true,
  }, with_context: false) }}
{% endif %}
