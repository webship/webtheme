{#
/**
 * @file
 * Theme override for displaying a single search result.
 *
 * Delegates the markup to the webtheme:search-result SDC.
 *
 * @see template_preprocess_search_result()
 */
#}
{{ attach_library('webtheme/search-results') }}
{% embed 'webtheme:search-result' with {
  url: url,
  title: title,
  title_attributes: title_attributes,
  content_attributes: content_attributes,
  info_split: info_split,
  info_date: info_date,
  snippet: snippet,
  layout: layout,
} %}
  {% block title_prefix %}{{ title_prefix }}{% endblock %}
  {% block title_suffix %}{{ title_suffix }}{% endblock %}
{% endembed %}
