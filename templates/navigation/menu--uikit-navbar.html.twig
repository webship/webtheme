{#
/**
 * @file
 * Theme override for menus placed in the navbar regions: UIkit Navbar nav.
 *
 * Menus in the center and right regions are hidden on small screens: the
 * Offcanvas region takes over there (the main and the account menus).
 *
 * Available variables:
 * - items: A nested list of menu items.
 * - uikit_region: The region of the menu block.
 *
 * @see \Drupal\webtheme\Hook\ThemeHooks::themeSuggestionsMenuAlter()
 */
#}
{% if items %}
  {{ include('webtheme:navbar_nav', {
    items: items,
    attributes: {
      class: uikit_region in ['navbar_center', 'navbar_right'] ? ['uk-visible@m'] : [],
    },
  }, with_context: false) }}
{% endif %}
