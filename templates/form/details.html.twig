{#
/**
 * @file
 * Theme override for a details element.
 *
 * Delegates the markup to the webtheme:details SDC.
 *
 * @see template_preprocess_details()
 * @see webtheme_preprocess_details()
 */
#}
{% include 'webtheme:details' with {
  title: title,
  summary_attributes: summary_attributes,
  content_attributes: content_attributes,
  required: required,
  description: description,
  errors: errors,
  children: children,
  value: value,
} %}
