{#
/**
 * @file
 * Theme override for the views mini-pager, with the UIkit Pagination component.
 *
 * Available variables:
 * - items: List of pager items, normalized as links.
 *
 * @see \Drupal\webtheme\Hook\PreprocessHooks::preprocessViewsMiniPager()
 */
#}
{% if items %}
  {{ include('webtheme:pagination', {
    items: items,
    alignment: 'center',
  }, with_context: false) }}
{% endif %}
