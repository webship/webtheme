{% set ratios = {
  'default': ['1-3', '1-3', '1-3'],
  'col_50_25_25': ['1-2', '1-4', '1-4'],
  'col_25_50_25': ['1-4', '1-2', '1-4'],
  'col_25_25_50': ['1-4', '1-4', '1-2'],
} %}
{% set widths = ratios[variant|default('default')]|default(ratios['default']) %}
{% set breakpoint = breakpoint|default('m') %}
{% set attributes = attributes.addClass([
  'uk-grid',
  gap ? 'uk-grid-' ~ gap,
  divider ? 'uk-grid-divider',
  match ? 'uk-grid-match',
  vertical_align ? 'uk-flex-' ~ vertical_align,
]).setAttribute('uk-grid', '') %}
<div{{ attributes }}>
  {% for column in [column_1, column_2, column_3] %}
    <div class="uk-width-1-1 uk-width-{{ widths[loop.index0] }}@{{ breakpoint }}">
      {{ column }}
    </div>
  {% endfor %}
</div>
