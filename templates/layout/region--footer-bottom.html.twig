{#
/**
 * @file
 * Webtheme's theme override to display the footer-bottom region.
 *
 * Delegates the markup to the webtheme:region SDC with the grid modifier
 * classes this region uses.
 *
 * @see template_preprocess_region()
 */
#}
{% embed 'webtheme:region' with {
  region: region,
  modifier_classes: ['grid-full', 'layout--pass--content-medium', 'ie11-autorow'],
} %}
  {% block content %}{{ content }}{% endblock %}
{% endembed %}
