{#
/**
 * @file
 * Theme override to display primary (UIkit Tab) and secondary (UIkit Subnav)
 * local tasks.
 *
 * Available variables:
 * - primary: HTML list items representing primary tasks.
 * - secondary: HTML list items representing secondary tasks.
 */
#}
{% if primary %}
  <h2 class="visually-hidden">{{ 'Primary tabs'|t }}</h2>
  <ul class="uk-tab">{{ primary }}</ul>
{% endif %}
{% if secondary %}
  <h2 class="visually-hidden">{{ 'Secondary tabs'|t }}</h2>
  <ul class="uk-subnav uk-subnav-pill">{{ secondary }}</ul>
{% endif %}
