{% set attributes = attributes.addClass([
  'uk-section',
  'uk-section-' ~ variant|default('default'),
  size ? 'uk-section-' ~ size,
  padding_remove ? 'uk-padding-remove-' ~ padding_remove,
  preserve_color ? 'uk-preserve-color',
]) %}
{% set container = container|default('default') %}
{# A page layout marks the sections of the page: the main content (with the
   target of the skip link), the header, the footer and complementary
   content. #}
{% set section_tag = landmark in ['main', 'header', 'footer', 'aside'] ? landmark : 'div' %}
{% if label and section_tag != 'div' %}
  {% set attributes = attributes.setAttribute('aria-label', label) %}
{% endif %}
{% if landmark == 'main' %}
  {% set attributes = attributes.setAttribute('id', 'main-content').setAttribute('tabindex', '-1') %}
{% endif %}
<{{ section_tag }}{{ attributes }}>
  {% if container == 'none' %}
    {{ content }}
  {% else %}
    <div class="uk-container{{ container != 'default' ? ' uk-container-' ~ container }}">
      {{ content }}
    </div>
  {% endif %}
</{{ section_tag }}>
