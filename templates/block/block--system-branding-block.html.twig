{% extends "block.html.twig" %}
{#
/**
 * @file
 * Theme override for the site branding block: UIkit logo.
 *
 * Available variables:
 * - site_logo: Logo for site as defined in Appearance or theme settings.
 * - site_name: Name for site as defined in Site information settings.
 * - site_slogan: Slogan for site as defined in Site information settings.
 */
#}
{% block content %}
  <a href="{{ path('<front>') }}" class="uk-navbar-item uk-logo" rel="home">
    {% if site_logo %}
      <img src="{{ site_logo }}" alt="{{ 'Home'|t }}" height="40" class="uk-margin-small-right">
    {% endif %}
    {% if site_name %}
      <span>{{ site_name }}</span>
    {% endif %}
  </a>
  {% if site_slogan %}
    <div class="uk-navbar-item uk-text-meta uk-visible@l">{{ site_slogan }}</div>
  {% endif %}
{% endblock %}
