{#
/**
 * @file
 * Webtheme's template for a documentation page: a node that sits in a book outline.
 *
 * Extends page.html.twig and replaces its main area with the three columns of a documentation
 * site: the book's outline on the left (with the search and the light/dark switch), the article in
 * the middle, and "On this page" on the right, which js/docs.js fills from the article's headings.
 *
 * Available variables, beyond page.html.twig's:
 * - docs.tree: The whole outline of the book this page is in, rendered as book-tree--docs.html.twig.
 * - docs.book_title, docs.book_url: The book's root page.
 *
 * @see webtheme_preprocess_page()
 * @see webtheme_theme_suggestions_page_alter()
 */
#}
{% extends "@webtheme/layout/page.html.twig" %}

{% block main %}
  <div id="main-wrapper" class="docs">
    <div class="docs__bar">
      <button class="docs__bar-button" type="button" data-docs-sidebar-toggle aria-expanded="false" aria-controls="docs-sidebar">
        <svg class="docs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        {{ 'Contents'|t }}
      </button>
    </div>

    <aside id="docs-sidebar" class="docs-sidebar" aria-label="{{ 'Documentation'|t }}">
      <div class="docs-sidebar__inner">
        <div class="docs-sidebar__tools">
          <button class="docs-search-open" type="button" data-docs-search-open aria-haspopup="dialog" aria-controls="docs-search">
            <svg class="docs-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <span class="docs-search-open__label">{{ 'Search'|t }}</span>
            <kbd class="docs-kbd" aria-hidden="true">Ctrl K</kbd>
          </button>
          <button class="docs-theme-toggle" type="button" data-docs-theme-toggle aria-pressed="false" title="{{ 'Switch between light and dark'|t }}">
            <svg class="docs-icon docs-icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="docs-icon docs-icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <span class="visually-hidden">{{ 'Dark mode'|t }}</span>
          </button>
        </div>
        {% if docs.book_title %}
          <a class="docs-sidebar__home" href="{{ docs.book_url }}">
            <svg class="docs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/></svg>
            {{ docs.book_title }}
          </a>
        {% endif %}
        <nav class="docs-nav" aria-label="{{ 'Pages'|t }}" data-docs-nav>
          {{ docs.tree }}
        </nav>
      </div>
    </aside>

    <main class="docs-main" role="main">
      <a id="main-content" tabindex="-1"></a>
      {{ page.highlighted }}
      {{ page.breadcrumb }}
      <article class="docs-article" data-docs-article>
        {{ page.content_above }}
        {{ page.content }}
      </article>
      {{ page.content_below }}
    </main>

    <aside class="docs-toc" aria-label="{{ 'On this page'|t }}">
      <div class="docs-toc__inner">
        <p class="docs-toc__title">{{ 'On this page'|t }}</p>
        <nav class="docs-toc__nav" data-docs-toc></nav>
      </div>
    </aside>
  </div>

  <dialog id="docs-search" class="docs-search" aria-label="{{ 'Search the documentation'|t }}" data-docs-search>
    <form class="docs-search__form" role="search" action="{{ path('search.view_node_search') }}" method="get">
      <svg class="docs-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input class="docs-search__input" type="search" name="keys" placeholder="{{ 'Search the documentation…'|t }}" autocomplete="off" spellcheck="false" aria-label="{{ 'Search the documentation'|t }}">
      <button class="docs-search__close" type="button" data-docs-search-close aria-label="{{ 'Close'|t }}">Esc</button>
    </form>
    <ul class="docs-search__results" role="listbox" data-docs-search-results></ul>
    <p class="docs-search__hint">{{ 'Type to find a page. Enter opens the selected page; with nothing selected, Enter searches the whole site.'|t }}</p>
  </dialog>
{% endblock %}
