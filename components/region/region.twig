{#
/**
 * @file
 * Webtheme SDC: region.
 *
 * Emits the same region / region--{name} wrapper markup as the original
 * theme overrides, so the live webship.co layout CSS keeps working. The
 * component renders nothing when the content slot is empty (matching the
 * original {% if content %} guard).
 */
#}
{% set tag = wrapper in ['div', 'aside'] ? wrapper : 'div' %}
{% set region_classes = ['region', 'region--' ~ region|clean_class]|merge(modifier_classes ?? []) %}
{% set _content %}{% block content %}{% endblock %}{% endset %}
{% if _content|trim is not empty %}
  <{{ tag }}{{ attributes.addClass(region_classes) }}>
    {{ _content }}
  </{{ tag }}>
{% endif %}
