{#
/**
 * @file
 * Theme override for views to display rows in a grid.
 *
 * Delegates the markup to the webtheme:views-view-grid SDC.
 *
 * @see template_preprocess_views_view_grid()
 */
#}
{% if options.alignment == 'vertical' %}
  {{ attach_library('webtheme/layout-views-grid-vertical') }}
{% else %}
  {{ attach_library('webtheme/layout-views-grid-horizontal') }}
{% endif %}
{% include 'webtheme:views-view-grid' with { title: title, options: options, items: items } %}
